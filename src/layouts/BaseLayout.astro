---
/**
 * BaseLayout — Phase 1 shell (D02/D05/D11/D14/D18/D19).
 * html/head/meta + fonts + header/footer + Lenis inline init (Task 1-3 done).
 * SHELL now; sitemap/robots + favicon-final + EN strings are later phases.
 */
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

export interface Props {
  /** Full SEO props shell (D05). Page title, VI. */
  title?: string;
  description?: string;
  lang?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  twitterCard?: string;
  noindex?: boolean;
  /** Active route for header aria-current. */
  currentPath?: string;
}

const {
  title = 'Vixie Web — Phase 1',
  description = 'Phase 1 giao khung sống: cuộn mượt, tokens chuẩn, shell đủ. Tải app mở Phase 2.',
  lang = 'vi',
  canonical,
  ogImage,
  ogType = 'website',
  twitterCard = 'summary_large_image',
  noindex = false,
  currentPath = '/',
} = Astro.props;

const site = Astro.site ? Astro.site.toString().replace(/\/$/, '') : '';
const canonicalUrl = canonical ?? (site ? `${site}${currentPath}` : undefined);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Vixie Web',
  inLanguage: 'vi',
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {/* Temp Astro favicon (D12); official favicon deferred to Phase 10 */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    {/* Full OG/Twitter/JSON-LD shell (D11); sitemap/robots finalization NOT here (Phase 10) */}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="vi_VN" />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {/* Task 2-1: exactly 2 font preloads (C06) — Sans 600 vi (hero H1 diacritics) + Sans 400 vi (body).
        Self-hosted same-origin, so preconnect is a no-op (kept as contract note, no external tag). Never >2. */}
    <link rel="preload" href="/fonts/ibm-plex-sans-vietnamese-600-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/ibm-plex-sans-vietnamese-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    {/* Task 1-3 init lives at end of <body> (inline client-only script, E02) */}
  </head>
  <body>
    <div class="strip" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
    <Header currentPath={currentPath} />
    <main>
      <slot />
    </main>
    <Footer />
    {/* Task 1-3 inline init (E02/E15, client-only): wiring lives in ../lib/lenis-init
        (E04 duration 1.2 expo-out, E05 single gsap.ticker loop, E06 ScrollTrigger,
        E07 anchors offset -64, E08 reduced-motion kill, E12 keep html/body overflow
        visible + data-lenis-prevent, E13 destroy on pagehide, NO View Transitions,
        NO parallax/pinning/scrub). Singleton window.__lenis + data-lenis-init
        shared with the React island. */}
    <script>
      if (typeof window !== 'undefined') {
        import('../lib/lenis-init.ts')
          .then(function (m) {
            return m.initLenis();
          })
          .catch(function (err) {
            console.error('[lenis] init failed; native scroll fallback', err);
          });
      }
    </script>
  </body>
</html>

---
/**
 * BaseLayout — Phase 2 Task 1-2 (tracer-b, FOUN-06/07, covers V1/V3).
 * Locale-aware head: html[lang] + og:locale/alternate + hreflang en/vi +
 * x-default → /en/ equivalent + self canonical ALL derive from
 * getLangFromUrl(Astro.url) (default en). Dual theme-color metas are FINAL
 * (paper light / ink dark, Task 2-1, D13) + anti-FOUC head script (D09/D16,
 * key `vixie-theme`, pitfalls 10+11). <main id="main" tabindex="-1"> is the
 * skip-link target (E07).
 * Reversibility: COSTLY (A01 default+prefix, A09 page moves) — rating
 * recorded in task report, no checkpoint per 02-PLAN ledger.
 */
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import '../styles/global.css';

export interface Props {
  /** Full SEO props shell (D05). Page title, locale default. */
  title?: string;
  description?: string;
  /** Optional explicit override; default derives from URL locale. */
  lang?: 'en' | 'vi';
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  twitterCard?: string;
  noindex?: boolean;
  /** Active route for header aria-current (locale-prefixed). */
  currentPath?: string;
}

const lang = Astro.props.lang ?? getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const {
  title = t('meta.title'),
  description = t('meta.description'),
  canonical,
  ogImage,
  ogType = 'website',
  twitterCard = 'summary_large_image',
  noindex = false,
  currentPath = '/',
} = Astro.props;

const site = Astro.site ? Astro.site.toString().replace(/\/$/, '') : '';
const pathname = Astro.url.pathname;
const canonicalUrl = canonical ?? (site ? `${site}${pathname}` : undefined);
// hreflang alternates: current path minus locale prefix, re-prefixed per locale.
const suffix = pathname.replace(/^\/(en|vi)(?=\/|$)/, '');
const barePath = suffix.startsWith('/') ? suffix : `/${suffix}`;
const bareSuffix = barePath === '/' ? '/' : barePath;
const enUrl = site ? `${site}/en${bareSuffix}` : undefined;
const viUrl = site ? `${site}/vi${bareSuffix}` : undefined;
const ogLocale = lang === 'en' ? 'en_US' : 'vi_VN';
const ogLocaleAlternate = lang === 'en' ? 'vi_VN' : 'en_US';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Vixie Web',
  inLanguage: lang,
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Task 2-1 anti-FOUC (D09/D16, pitfalls 10+11): .js gate + .dark BEFORE
        first paint. localStorage 'vixie-theme' wins after an explicit choice,
        else OS. is:inline keeps it synchronous in <head>. */}
    <script is:inline>
      (function () {
        document.documentElement.classList.add('js', 'js-gated');
        var mode = null;
        try {
          mode = localStorage.getItem('vixie-theme');
        } catch {
          mode = null;
        }
        var dark = false;
        try {
          dark =
            mode === 'dark' ||
            (!mode && window.matchMedia('(prefers-color-scheme: dark)').matches);
        } catch {
          dark = false;
        }
        if (dark) document.documentElement.classList.add('dark');
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {enUrl && <link rel="alternate" hreflang="en" href={enUrl} />}
    {viUrl && <link rel="alternate" hreflang="vi" href={viUrl} />}
    {enUrl && <link rel="alternate" hreflang="x-default" href={enUrl} />}
    {/* theme-color FINAL (Task 2-1, D13): paper light / ink dark via media */}
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f7f7f5" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#101010" />
    {/* Temp Astro favicon (D12); official favicon deferred to Phase 10 */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    {/* Full OG/Twitter/JSON-LD shell (D11); sitemap/robots finalization NOT here (Phase 10) */}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlternate} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {/* Task 2-1: exactly 2 font preloads (C06) — Sans 600 vi (hero H1 diacritics) + Sans 400 vi (body).
        Self-hosted same-origin, so preconnect is a no-op (kept as contract note, no external tag). Never >2. */}
    <link rel="preload" href="/fonts/ibm-plex-sans-vietnamese-600-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/ibm-plex-sans-vietnamese-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    {/* Task 1-3 init lives at end of <body> (inline client-only script, E02) */}
  </head>
  <body>
    {/* Task 2-2 skip-link (FOUN-09, E05-E07): FIRST focusable element in <body>,
        dict text, href="#main". Visually hidden off-screen until :focus-visible
        (cyan 3px, see .skip-link in global.css). Main carries tabindex="-1" +
        per-locale aria-label (E08) so Enter moves focus into content. */}
    <a class="skip-link" href="#main">{t('skip.link')}</a>
    <div class="strip" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
    <Header currentPath={currentPath} />
    <main id="main" tabindex="-1" aria-label={t('main.label')}>
      <slot />
    </main>
    <Footer />
    {/* Task 2-2 skip-link focus (E06): native fragment jump scrolls, but focus
        must also land in #main for keyboard/SR users. Lenis intercepts the
        same click for offset scroll (lenis-init onClick); this listener only
        moves focus with preventScroll so the two cooperate, no double-jump. */}
    <script>
      document.querySelector('.skip-link')?.addEventListener('click', () => {
        const main = document.getElementById('main');
        if (main) main.focus({ preventScroll: true });
      });
    </script>
    {/* Task 1-3 inline init (E02/E15, client-only): wiring lives in ../lib/lenis-init
        (E04 duration 1.2 expo-out, E05 single ticker loop, E06 ScrollTrigger,
        E07 anchors offset -64, E08 reduced-motion kill, E12 keep html/body overflow
        visible + data-lenis-prevent, E13 destroy on pagehide, NO View Transitions,
        NO parallax/pinning/scrub). Singleton window.__lenis + data-lenis-init
        shared with the React island. */}
    <script>
      // Motion-guard FIRST (Task 2-2, E01-E03): initLenis re-checks reduce
      // internally, but this explicit FIRST check avoids even fetching the
      // Lenis/GSAP bundles under reduce and settles reveals without motion.
      // Header reveal script settles the same targets; this mirrors it here.
      if (typeof window !== 'undefined') {
        if (
          typeof window.matchMedia !== 'undefined' &&
          window.matchMedia('(prefers-reduced-motion: reduce)').matches
        ) {
          document.querySelectorAll('.rv').forEach((el) => el.classList.add('in'));
        } else {
          import('../lib/lenis-init.ts')
            .then(function (m) {
              return m.initLenis();
            })
            .catch(function (err) {
              console.error('[lenis] init failed; native scroll fallback', err);
            });
        }
      }
    </script>
  </body>
</html>

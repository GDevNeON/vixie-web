---
/**
 * PageLayout — D06 default (planner-locked): BaseLayout + 1400/24 container + page header.
 * Phase 2 Task 1-2: locale passes through to BaseLayout (URL-derived when unset).
 * No other delta. Pages own their header markup via the `page-header` slot.
 */
import BaseLayout from './BaseLayout.astro';

export interface Props {
  title?: string;
  description?: string;
  lang?: 'en' | 'vi';
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  twitterCard?: string;
  noindex?: boolean;
  currentPath?: string;
}

const { currentPath = '/', lang, ...seo } = Astro.props;
---
<BaseLayout currentPath={currentPath} lang={lang} {...seo}>
  <div class="shell">
    <slot name="page-header" />
    <slot />
  </div>
</BaseLayout>

---
/**
 * Footer — full 4-col shell, Phase 2 Task 1-3 (tracer-c, FOUN-06/07, V2/V3).
 * Shell labels + blurb via t() (locked UI-SPEC §11). Site/legal/support rows
 * stay dead spans with aria-disabled and translated labels. Email + year live.
 * Meta /tokens link is locale-aware. Giant stays decorative brand text.
 */
import { getLangFromUrl, useTranslations } from '../i18n/utils';

export interface Props {
  lang?: 'en' | 'vi';
}

const lang = Astro.props.lang ?? getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();
const tokensHref = `/${lang}/tokens`;
---
<div class="shell foot-wrap">
  <div class="giant" aria-hidden="true">vixie<em>.</em></div>
  <footer class="ft">
    <div>
      <span class="lab">{t('footer.shell')}</span>
      <p class="small">
        {t('footer.blurb')}
        {t('footer.rights', { year: String(year) })} · <a class="mail" href="mailto:acc.tester.trial@gmail.com">acc.tester.trial@gmail.com</a> (LEGA-06).
      </p>
    </div>
    <div>
      <span class="lab">{t('footer.site')}</span>
      <span class="dim-blk" aria-disabled="true">{t('footer.landing')}</span>
      <span class="dim-blk" aria-disabled="true">{t('footer.docs')}</span>
      <span class="dim-blk" aria-disabled="true">{t('footer.blog')}</span>
      <span class="dim-blk" aria-disabled="true">{t('footer.download')}</span>
    </div>
    <div>
      <span class="lab">{t('footer.legal')}</span>
      <span class="dim-blk" aria-disabled="true">{t('footer.privacy')}</span>
      <span class="dim-blk" aria-disabled="true">{t('footer.terms')}</span>
      <span class="dim-blk" aria-disabled="true">{t('footer.content')}</span>
      <span class="dim-blk" aria-disabled="true">{t('footer.changelog')}</span>
    </div>
    <div>
      <span class="lab">{t('footer.meta')}</span>
      <a href={tokensHref}>/tokens</a>
      <span class="lab">{t('footer.supportcontact')}</span>
      <span class="dim-blk" aria-disabled="true">{t('footer.support')}</span>
      <span class="dim-blk" aria-disabled="true">{t('footer.contact')}</span>
    </div>
  </footer>
  <!-- baseline build note kept out of visual layer: tokens.css → global.css · @theme CSS-first · MDX build-only · Playwright 1 smoke -->
  <div class="base"></div>
</div>

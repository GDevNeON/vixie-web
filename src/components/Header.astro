---
/**
 * Header — sticky 64px shell, Phase 2 Task 1-3 (tracer-c, FOUN-06/07, V2/V3).
 * All chrome via t(): live nav, dead spans, CTA, burger, aria labels.
 * Brand -> /<lang>/, CTA -> /<lang>/tokens, aria-current on locale-aware path.
 * Switcher VI|EN in .hright + duplicate in burger panel (pitfall 12):
 * same-path prefix swap + search+hash, unknown route -> /<other>/ homepage
 * (4-route allowlist '', tokens, docs, 404). Current locale renders as a span
 * with aria-current="page", never a self link. A runtime script re-applies
 * location.search+hash because the static build cannot know them.
 * Phase 2 Task 2-1 adds ThemeToggle (FOUN-10, D11/D16): sun/moon icon +
 * aria-pressed + dict label, in .hright next to the switcher AND as a
 * duplicate inside the burger panel; localStorage wins, else OS.
 */
import Logo from './Logo.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

export interface Props {
  currentPath?: string;
  lang?: 'en' | 'vi';
}

const { currentPath = '/' } = Astro.props;
const lang = Astro.props.lang ?? getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const other: 'en' | 'vi' = lang === 'en' ? 'vi' : 'en';

const homeHref = `/${lang}/`;
const tokensHref = `/${lang}/tokens`;

// Locale-aware active state, tolerant of a trailing slash.
const norm = (p: string) => (p.length > 1 ? p.replace(/\/+$/, '') : p);
const cur = norm(currentPath);
const isHome = cur === norm(homeHref) || cur === `/${lang}`;
const isTokens = cur === norm(tokensHref);

// Same-path prefix swap + query/hash. Unknown shell route -> other homepage.
const pathname = Astro.url.pathname;
const suffix = pathname.replace(/^\/(en|vi)(?=\/|$)/, '');
const bare = suffix.startsWith('/') ? suffix : `/${suffix}`;
const route = bare.replace(/^\/+|\/+$/g, '');
const KNOWN = ['', 'tokens', 'docs', '404'];
const targetBase = KNOWN.includes(route) ? `/${other}${bare === '/' ? '/' : bare}` : `/${other}/`;
const otherHref = `${targetBase}${Astro.url.search}${Astro.url.hash}`;
---
<header class="top">
  <div class="shell top-inner">
    <a class="brand" href={homeHref} aria-label={t('nav.brand')}>
      <Logo />
      <span class="word">WEB · P1</span>
    </a>
    <nav class="main" id="site-nav" aria-label={t('nav.label')}>
      <a class="hcta hcta--panel" href={tokensHref}>{t('header.cta')}</a>
      <a href={homeHref} aria-current={isHome ? 'page' : undefined}>{t('nav.home')}</a>
      <a href={tokensHref} aria-current={isTokens ? 'page' : undefined}>{t('nav.tokens')}</a>
      <span class="lab nav-lab">{t('nav.phase')}</span>
      <span class="dim-nav" aria-disabled="true">{t('nav.docs')}</span>
      <span class="dim-nav" aria-disabled="true">{t('nav.blog')}</span>
      <span class="dim-nav" aria-disabled="true">{t('nav.download')}</span>
      <div class="panel-utils">
      <div class="switcher switcher--panel">
        {lang === 'vi' ? (
          <>
            <span class="sw-cur" aria-current="page">{t('switcher.vi')}</span>
            <span class="sw-sep" aria-hidden="true">|</span>
            <a href={otherHref} data-switcher data-target="en">{t('switcher.en')}</a>
          </>
        ) : (
          <>
            <a href={otherHref} data-switcher data-target="vi">{t('switcher.vi')}</a>
            <span class="sw-sep" aria-hidden="true">|</span>
            <span class="sw-cur" aria-current="page">{t('switcher.en')}</span>
          </>
        )}
      </div>
      <button
        class="theme-toggle theme-toggle--panel"
        type="button"
        data-theme-toggle
        aria-pressed="false"
        aria-label={t('theme.label')}
        title={t('theme.label')}
      ><svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" /></svg><svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" /></svg></button>
      </div>
    </nav>
    <div class="hright">
      <a class="hcta" href={tokensHref}>{t('header.cta')}</a>
      <nav class="switcher" aria-label={t('switcher.label')}>
        {lang === 'vi' ? (
          <>
            <span class="sw-cur" aria-current="page">{t('switcher.vi')}</span>
            <span class="sw-sep" aria-hidden="true">|</span>
            <a href={otherHref} data-switcher data-target="en">{t('switcher.en')}</a>
          </>
        ) : (
          <>
            <a href={otherHref} data-switcher data-target="vi">{t('switcher.vi')}</a>
            <span class="sw-sep" aria-hidden="true">|</span>
            <span class="sw-cur" aria-current="page">{t('switcher.en')}</span>
          </>
        )}
      </nav>
      <button
        class="theme-toggle"
        type="button"
        data-theme-toggle
        aria-pressed="false"
        aria-label={t('theme.label')}
        title={t('theme.label')}
      ><svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" /></svg><svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" /></svg></button>
      <button
        class="burger"
        type="button"
        aria-label={t('burger.open.label')}
        aria-expanded="false"
        aria-controls="site-nav"
        data-menu={t('burger.menu')}
        data-close={t('burger.close')}
        data-open-label={t('burger.open.label')}
        data-close-label={t('burger.close.label')}
      >{t('burger.menu')}</button>
    </div>
  </div>
</header>
<span
  class="progress"
  id="scroll-progress"
  role="progressbar"
  aria-label={t('nav.progress')}
  aria-valuemin="0"
  aria-valuemax="100"
  aria-valuenow="0"
></span>
<style>
  .switcher {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font: 600 var(--text-xs) / 1 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .switcher a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 8px;
    border: 1px solid transparent;
    border-radius: var(--radius-control);
    color: var(--color-ink);
    text-decoration: none;
  }
  .switcher a:hover,
  .switcher a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .switcher a:active { transform: scale(0.98); }
  .switcher .sw-cur {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 8px;
    border: 1px solid var(--color-ink);
    border-radius: var(--radius-control);
    background: var(--color-ink);
    color: var(--color-paper);
  }
  .switcher .sw-sep { opacity: 0.5; }
  /* Panel copy is the mobile duplicate (pitfall 12): hidden on desktop,
     shown inside the open burger dropdown. Task 2-2 fix (a): the html-level
     .js gate MUST be :global — bare `:is(.js,…)` compiles to
     `:is(.js,…)[data-cid]` and can never match <html>, so the panel never
     appeared. Theme panel works because its rule lives in global.css. */
  .switcher--panel { display: none; }
  @media (max-width: 920px) {
    :global(.js) nav.main.open .switcher--panel,
    :global(.js-gated) nav.main.open .switcher--panel { display: inline-flex; }
  }
  /* Task 2-1 dark (FOUN-10): :global(.dark) keeps the html-level class
     matchable from scoped CSS (bare `.dark` would compile to
     `.dark[data-cid]` and never match). Light-paper literal: under .dark,
     var(--color-paper) resolves to ink, so paper text needs #f7f7f5. */
  :global(.dark) .switcher a {
    color: #f7f7f5;
  }
  :global(.dark) .switcher .sw-cur {
    color: #f7f7f5;
  }
  @media (prefers-color-scheme: dark) {
    :global(html:not(.js):not(.js-gated)) .switcher a {
      color: #f7f7f5;
    }
    :global(html:not(.js):not(.js-gated)) .switcher .sw-cur {
      color: #f7f7f5;
    }
  }
  @media print {
    :global(.dark) .switcher a {
      color: var(--color-ink);
    }
    :global(.dark) .switcher .sw-cur {
      color: var(--color-paper);
    }
  }
</style>
<script>
  // Shell interactions (Tasks 1-2 + 2-3 polish). Lenis wiring belongs to Task 1-3.
  // Gate first: CSS hides the mobile nav / shows the burger ONLY under .js,
  // so no-JS degrades to a wrapped inline list and content stays visible.
  document.documentElement.classList.add('js', 'js-gated');
  const burger = document.querySelector('.burger');
  const nav = document.getElementById('site-nav');
  // Per-locale labels come from data attributes (dict-driven, never hardcoded).
  const menuText = burger instanceof HTMLButtonElement ? (burger.getAttribute('data-menu') ?? 'MENU') : 'MENU';
  const closeText = burger instanceof HTMLButtonElement ? (burger.getAttribute('data-close') ?? 'CLOSE') : 'CLOSE';
  const openLabel = burger instanceof HTMLButtonElement ? (burger.getAttribute('data-open-label') ?? 'Open menu') : 'Open menu';
  const closeLabel = burger instanceof HTMLButtonElement ? (burger.getAttribute('data-close-label') ?? 'Close menu') : 'Close menu';
  const closeMenu = () => {
    if (!nav) return;
    nav.classList.remove('open');
    if (burger instanceof HTMLButtonElement) {
      burger.setAttribute('aria-expanded', 'false');
      burger.textContent = menuText;
      burger.setAttribute('aria-label', openLabel);
    }
  };
  if (burger instanceof HTMLButtonElement && nav) {
    burger.addEventListener('click', () => {
      const open = nav.classList.toggle('open');
      burger.setAttribute('aria-expanded', String(open));
      burger.textContent = open ? closeText : menuText;
      burger.setAttribute('aria-label', open ? closeLabel : openLabel);
      // Task 2-2 (E12 delta): keyboard focus moves INTO the menu on open so
      // the panel is operable without extra tabs. First link = locale home.
      if (open) {
        const first = nav.querySelector('a, button');
        if (first instanceof HTMLElement) first.focus();
      }
    });
    // Keyboard: Escape closes the dropdown and returns focus to the burger.
    addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && nav.classList.contains('open')) {
        closeMenu();
        burger.focus();
      }
    });
  }
  // Switcher runtime: the static build bakes an empty search/hash, so re-apply
  // the live location query+hash and the 4-route fallback on the client.
  const KNOWN_ROUTES = ['', 'tokens', 'docs', '404'];
  document.querySelectorAll('a[data-switcher]').forEach((el) => {
    if (!(el instanceof HTMLAnchorElement)) return;
    const target = el.getAttribute('data-target');
    if (target !== 'en' && target !== 'vi') return;
    const path = location.pathname;
    const suffix = path.replace(/^\/(en|vi)(?=\/|$)/, '');
    const bare = suffix.startsWith('/') ? suffix : `/${suffix}`;
    const route = bare.replace(/^\/+|\/+$/g, '');
    const base = KNOWN_ROUTES.includes(route) ? `/${target}${bare === '/' ? '/' : bare}` : `/${target}/`;
    el.setAttribute('href', base + location.search + location.hash);
  });
  // Theme toggle (Task 2-1, FOUN-10, D07/D08/D16): localStorage wins after an
  // explicit choice, else OS. The head anti-FOUC script already set the initial
  // .dark pre-paint; here we only sync buttons, persist clicks, and follow live
  // OS changes while no explicit choice is stored.
  const THEME_KEY = 'vixie-theme';
  const readStoredTheme = () => {
    try {
      return localStorage.getItem(THEME_KEY);
    } catch {
      return null;
    }
  };
  const syncThemeButtons = () => {
    const dark = document.documentElement.classList.contains('dark');
    document.querySelectorAll('[data-theme-toggle]').forEach((el) => {
      if (el instanceof HTMLButtonElement) el.setAttribute('aria-pressed', String(dark));
    });
  };
  const setDark = (dark = false, persist = false) => {
    document.documentElement.classList.toggle('dark', dark);
    syncThemeButtons();
    if (persist) {
      try {
        localStorage.setItem(THEME_KEY, dark ? 'dark' : 'light');
      } catch {
        // Private mode: theme still applies for this visit, just won't persist.
      }
    }
  };
  document.querySelectorAll('[data-theme-toggle]').forEach((el) => {
    if (!(el instanceof HTMLButtonElement)) return;
    el.addEventListener('click', () => {
      setDark(!document.documentElement.classList.contains('dark'), true);
    });
  });
  syncThemeButtons();
  try {
    if (!readStoredTheme() && typeof matchMedia !== 'undefined') {
      const themeMq = matchMedia('(prefers-color-scheme: dark)');
      if (typeof themeMq.addEventListener === 'function') {
        themeMq.addEventListener('change', (event) => {
          if (!readStoredTheme()) setDark(event.matches, false);
        });
      }
    }
  } catch {
    // OS listener is best-effort; explicit toggle always works.
  }
  const progress = document.getElementById('scroll-progress');
  const updateProgress = () => {
    const el = document.documentElement;
    const max = el.scrollHeight - el.clientHeight;
    const value = max > 0 ? Math.round((el.scrollTop / max) * 100) : 0;
    if (progress) {
      progress.style.transform = `scaleX(${value / 100})`;
      progress.setAttribute('aria-valuenow', String(value));
    }
  };
  addEventListener('scroll', updateProgress, { passive: true });
  addEventListener('resize', updateProgress);
  updateProgress();
  // Reveal (UI-SPEC §6/§10): targets stay visible by default; `.armed`
  // (opacity 0 / translate 10px) is added ONLY while an IO observes them, so
  // no-JS / headless / IO-less renders never hide content. Stagger tail ≤140ms.
  const revealTargets = Array.from(document.querySelectorAll('.rv'));
  const reduceMotion =
    typeof matchMedia !== 'undefined' &&
    matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (revealTargets.length === 0 || reduceMotion || !('IntersectionObserver' in window)) {
    revealTargets.forEach((el) => el.classList.add('in'));
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('in');
            io.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12 },
    );
    revealTargets.forEach((el, i) => {
      if (el instanceof HTMLElement) el.style.transitionDelay = `${Math.min(i * 35, 140)}ms`;
      el.classList.add('armed');
      io.observe(el);
    });
  }
</script>

---
/**
 * Header — sticky 64px shell (D03/D08/D09).
 * Live nav: Trang chủ + Tokens. Dead placeholders are plain non-focusable spans,
 * NEVER fake-live href. Burger + progressbar wired below; Lenis anchors (E07)
 * belong to Task 1-3 — in-page fallback stays native until then.
 */
import Logo from './Logo.astro';

export interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
---
<header class="top">
  <div class="shell top-inner">
    <a class="brand" href="/" aria-label="Vixie home">
      <Logo />
      <span class="word">WEB · P1</span>
    </a>
    <nav class="main" id="site-nav" aria-label="Chính">
      <a href="/" aria-current={currentPath === '/' ? 'page' : undefined}>Trang chủ</a>
      <a href="/tokens" aria-current={currentPath === '/tokens' ? 'page' : undefined}>Tokens</a>
      <span class="lab nav-lab">Phase 2+</span>
      <span class="dim-nav">Tài liệu</span>
      <span class="dim-nav">Blog</span>
      <span class="dim-nav">Tải về</span>
    </nav>
    <div class="hright">
      <a class="hcta" href="/tokens">Xem /tokens</a>
      <button
        class="burger"
        type="button"
        aria-label="Mở menu"
        aria-expanded="false"
        aria-controls="site-nav"
      >MENU</button>
    </div>
  </div>
</header>
<span
  class="progress"
  id="scroll-progress"
  role="progressbar"
  aria-label="Tiến độ cuộn"
  aria-valuemin="0"
  aria-valuemax="100"
  aria-valuenow="0"
></span>
<script>
  // Shell interactions (Tasks 1-2 + 2-3 polish). Lenis wiring belongs to Task 1-3.
  // Gate first: CSS hides the mobile nav / shows the burger ONLY under .js,
  // so no-JS degrades to a wrapped inline list and content stays visible.
  document.documentElement.classList.add('js', 'js-gated');
  const burger = document.querySelector('.burger');
  const nav = document.getElementById('site-nav');
  const closeMenu = () => {
    if (!nav) return;
    nav.classList.remove('open');
    if (burger instanceof HTMLButtonElement) {
      burger.setAttribute('aria-expanded', 'false');
      burger.textContent = 'MENU';
    }
  };
  if (burger instanceof HTMLButtonElement && nav) {
    burger.addEventListener('click', () => {
      const open = nav.classList.toggle('open');
      burger.setAttribute('aria-expanded', String(open));
      burger.textContent = open ? 'ĐÓNG' : 'MENU';
    });
    // Keyboard: Escape closes the dropdown and returns focus to the burger.
    addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && nav.classList.contains('open')) {
        closeMenu();
        burger.focus();
      }
    });
  }
  const progress = document.getElementById('scroll-progress');
  const updateProgress = () => {
    const el = document.documentElement;
    const max = el.scrollHeight - el.clientHeight;
    const value = max > 0 ? Math.round((el.scrollTop / max) * 100) : 0;
    if (progress) {
      progress.style.transform = `scaleX(${value / 100})`;
      progress.setAttribute('aria-valuenow', String(value));
    }
  };
  addEventListener('scroll', updateProgress, { passive: true });
  addEventListener('resize', updateProgress);
  updateProgress();
  // Reveal (UI-SPEC §6/§10): targets stay visible by default; `.armed`
  // (opacity 0 / translate 10px) is added ONLY while an IO observes them, so
  // no-JS / headless / IO-less renders never hide content. Stagger tail ≤140ms.
  const revealTargets = Array.from(document.querySelectorAll('.rv'));
  const reduceMotion =
    typeof matchMedia !== 'undefined' &&
    matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (revealTargets.length === 0 || reduceMotion || !('IntersectionObserver' in window)) {
    revealTargets.forEach((el) => el.classList.add('in'));
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('in');
            io.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12 },
    );
    revealTargets.forEach((el, i) => {
      if (el instanceof HTMLElement) el.style.transitionDelay = `${Math.min(i * 35, 140)}ms`;
      el.classList.add('armed');
      io.observe(el);
    });
  }
</script>

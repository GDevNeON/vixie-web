---
/**
 * Logo — dual-img CSS swap for light/dark (Phase 2 Task 2-1, FOUN-10, D05/E11).
 * Both brand SVGs always render; global.css toggles lm/dm via `.dark`
 * (zero JS, zero FOUC). `variant` is kept for back-compat and ignored.
 * Both imgs carry alt="Vixie" — the display:none twin drops from the a11y tree.
 */
export interface Props {
  variant?: 'lm' | 'dm';
  alt?: string;
}

const { alt = 'Vixie' } = Astro.props;
---
<span class="logo">
  <img class="logo-lm" src="/vixie-brand-lm.svg" alt={alt} width="87" height="28" />
  <img class="logo-dm" src="/vixie-brand-dm.svg" alt={alt} width="87" height="28" />
</span>

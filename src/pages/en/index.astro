---
/**
 * `/en/` — English homepage shell (Phase 2 Task 1-2 tracer-b, FOUN-06/07).
 * EN copy (UI-SPEC §11 locked 2026-09-18); VI twin at src/pages/vi/index.astro.
 * Internal links locale-prefixed (/en/...). Header/footer chrome wires to
 * the dict in Task 1-3; Lenis island copy follows with its owner task.
 */
import PageLayout from '../../layouts/PageLayout.astro';
import LenisIsland from '../../components/LenisIsland.tsx';
---
<PageLayout title="Vixie Web — Phase 2" currentPath="/en/">
  <section class="hero" aria-labelledby="hero-h1">
    <div>
      <div class="kick">Phase 2 · FOUN-06..12 · EN default</div>
      <h1 id="hero-h1">companion <em>living</em> on your wallpaper.</h1>
      <p class="lead">Phase 2 ships the living frame in two languages: smooth scroll, true tokens, full shell. The app unlocks the download.</p>
      <div class="row">
        <a class="btn gh" href="/en/tokens">View /tokens</a>
      </div>
      <p class="cta-note small">
        <button class="btn cy" type="button" disabled aria-describedby="phase2-note">Download now</button>
        <span class="chip" id="phase2-note">Phase 2</span>
      </p>
    </div>
    <LenisIsland client:load lang="en" />
  </section>

  <section aria-labelledby="demo-h2">
    <div class="sec"><h2 id="demo-h2">Long scroll · Lenis demo</h2><span>no pinning</span></div>
    <!-- demo spec (build detail kept out of visual layer): duration ~1.2 · expo-out · anchor lenis.scrollTo · direct bundle, lazy Phase 10 · manual scroll + clean console + ScrollTrigger sync — NO pinning/scrub Phase 1 -->
    <div class="long"><span class="lab">Sample · scroll</span><p class="small">Scroll slowly through the sample strip to feel the living frame rhythm.</p></div>
  </section>
</PageLayout>
